{
  "manifest_version": 2,
  "name": "Netrofit Exporter",
  "version": "1.0",
  "description": "Captures API responses from app.netrofit.com and exports them as CSV.",
  "browser_specific_settings": {
    "gecko": {
      "id": "netrofit-exporter@localhost"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "downloads",
    "unlimitedStorage",
    "*://app.netrofit.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "48": "icons/icon.svg"
  }
}
